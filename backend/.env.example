# Environment variables - GERCEK DEGERLERLE DEGISTIR
DATABASE_URL=postgresql://user:password@localhost:5432/netflix_imdb
REDIS_URL=redis://localhost:6379
CACHE_TTL=3600
CACHE_ENABLED=true

# Virgulle ayrilmis API anahtarlari (her kisiye ayri anahtar). Bos birakilirsa
# /api/health disindaki tum endpoint'ler 401 doner.
API_KEYS=ornek-anahtar-1,ornek-anahtar-2
